<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.valachpatrik.cswap-chrome</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>@REPO@/cswap_chrome.py</string>
    <string>sync</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>@HOME@/.claude.json</string>
  </array>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardErrorPath</key>
  <string>@HOME@/.local/state/cswap-chrome/launchd.err</string>
</dict>
</plist>
